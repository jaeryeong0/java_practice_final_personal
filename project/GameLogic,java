import java.util.*;

// ==========================================
// [1] 기초 데이터 타입
// ==========================================
enum Role { SHERIFF, DEPUTY, OUTLAW, RENEGADE }
enum Suit { SPADE, HEART, DIAMOND, CLUB }
enum CardType { BLUE, BROWN }

// ==========================================
// [2] 카드 시스템 (모든 카드 종류 구현)
// ==========================================
abstract class Card {
    String name;
    Suit suit;
    int value;
    CardType type;

    public Card(String name, Suit suit, int value, CardType type) {
        this.name = name; this.suit = suit; this.value = value; this.type = type;
    }
    abstract void execute(Player user, Player target, Game game);
}

// --- 공격 카드 ---
class BangCard extends Card {
    public BangCard() { super("Bang!", Suit.SPADE, 1, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        if (target == null) return;
        user.hasPlayedBang = true;
        System.out.println("\n[!] " + user.name + " -> " + target.name + " 뱅!");
        if (!target.respondToBang(game)) game.loseHP(target, user, 1);
    }
}

class MissedCard extends Card {
    public MissedCard() { super("Missed!", Suit.CLUB, 1, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {}
}

class DuelCard extends Card { // 결투
    public DuelCard() { super("Duel", Suit.CLUB, 7, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        System.out.println("\n[!] " + user.name + "와 " + target.name + "의 결투 시작!");
        Player attacker = user;
        Player defender = target;
        while (true) {
            System.out.println(defender.name + "의 차례! 뱅을 내야 합니다.");
            if (!defender.discardSpecificCard(BangCard.class, game)) {
                game.loseHP(defender, attacker, 1);
                break;
            }
            // 공수 교대
            Player temp = attacker;
            attacker = defender;
            defender = temp;
        }
    }
}

// --- 전체 공격 ---
class IndiansCard extends Card { // 인디언
    public IndiansCard() { super("Indians", Suit.DIAMOND, 1, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        System.out.println("\n[!] 인디언 습격! 모든 플레이어는 뱅을 내야 합니다.");
        for (Player p : game.players) {
            if (p != user && p.hp > 0) {
                if (!p.discardSpecificCard(BangCard.class, game)) game.loseHP(p, user, 1);
            }
        }
    }
}

class GatlingCard extends Card { // 개틀링
    public GatlingCard() { super("Gatling", Suit.HEART, 10, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        System.out.println("\n[!] 개틀링 발사! 나를 제외한 전원이 타겟입니다.");
        for (Player p : game.players) {
            if (p != user && p.hp > 0) {
                if (!p.respondToBang(game)) game.loseHP(p, user, 1);
            }
        }
    }
}

// --- 회복 및 드로우 ---
class BeerCard extends Card {
    public BeerCard() { super("Beer", Suit.HEART, 1, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        game.getHP(user, 1);
    }
}

class WellsFargoCard extends Card { // 웰스 파고 (3장)
    public WellsFargoCard() { super("Wells Fargo", Suit.HEART, 3, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        for(int i=0; i<3; i++) user.drawCard(game.deck.popCard());
    }
}

class PanicCard extends Card { // 강도 (거리 1)
    public PanicCard() { super("Panic!", Suit.HEART, 8, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        if (target == null) return;
        Card stolen = target.hand.remove(0); // 단순화: 첫번째 카드 강탈
        user.drawCard(stolen);
        System.out.println(user.name + "가 " + target.name + "의 카드를 뺏어왔습니다.");
    }
}

class CatBalouCard extends Card { // 캣 벌로우 (거리 무관 버리기)
    public CatBalouCard() { super("Cat Balou", Suit.DIAMOND, 9, CardType.BROWN); }
    @Override void execute(Player user, Player target, Game game) {
        if (target == null || target.hand.isEmpty()) return;
        game.deck.discard(target.hand.remove(0));
        System.out.println(target.name + "의 카드를 한 장 버렸습니다.");
    }
}

// --- 장착 카드 (청색) ---
class WeaponCard extends Card {
    int range;
    public WeaponCard(String name, int range) {
        super(name, Suit.DIAMOND, 1, CardType.BLUE); this.range = range;
    }
    @Override void execute(Player user, Player target, Game game) {
        if (user.weapon != null) game.deck.discard(user.weapon);
        user.weapon = this;
    }
}

class BarrelCard extends Card { // 술통
    public BarrelCard() { super("Barrel", Suit.SPADE, 12, CardType.BLUE); }
    @Override void execute(Player user, Player target, Game game) { user.field.add(this); }
}

class JailCard extends Card { // 감옥
    public JailCard() { super("Jail", Suit.SPADE, 4, CardType.BLUE); }
    @Override void execute(Player user, Player target, Game game) {
        if (target.role == Role.SHERIFF) {
            System.out.println("보안관은 감옥에 갈 수 없습니다.");
            user.drawCard(this); return;
        }
        target.field.add(this);
    }
}

class DynamiteCard extends Card { // 다이너마이트
    public DynamiteCard() { super("Dynamite", Suit.HEART, 2, CardType.BLUE); }
    @Override void execute(Player user, Player target, Game game) { user.field.add(this); }
}

// ==========================================
// [3] 캐릭터 시스템
// ==========================================
abstract class Character {
    String name; int hp;
    public Character(String name, int hp) { this.name = name; this.hp = hp; }
    void onPhase1(Player self, Game game) {
        self.drawCard(game.deck.popCard()); self.drawCard(game.deck.popCard());
    }
    void onDamaged(Player self, Player attacker, Game game, int amount) {}
    int getDistanceMod() { return 0; }
    int getRangeMod() { return 0; }
    boolean canInfiniteBang() { return false; }
}

class BartCassidy extends Character { 
    public BartCassidy() { super("Bart Cassidy", 4); }
    @Override void onDamaged(Player self, Player attacker, Game game, int amount) {
        for(int i=0; i<amount; i++) self.drawCard(game.deck.popCard());
    }
}

class WillyTheKid extends Character { 
    public WillyTheKid() { super("Willy the Kid", 4); }
    @Override boolean canInfiniteBang() { return true; }
}

// ==========================================
// [4] 플레이어
// ==========================================
class Player {
    String name; int hp, maxHp;
    Role role; Character character;
    List<Card> hand = new ArrayList<>();
    List<Card> field = new ArrayList<>();
    WeaponCard weapon = null;
    boolean hasMustang = false, hasAppaloosa = false, hasPlayedBang = false, skipTurn = false;

    public Player(String name) { this.name = name; }

    public String getName() { return name; }
    public int getHp() { return hp; }
    public int getMaxHp() { return maxHp; }
    public Role getRole() { return role; }
    public Character getCharacter() { return character; }
    public List<Card> getHand() { return hand; }
    public List<Card> getField() { return field; }
    public WeaponCard getWeapon() { return weapon; }
    public boolean hasMustang() { return hasMustang; }
    public boolean hasAppaloosa() { return hasAppaloosa; }
    public boolean hasPlayedBang() { return hasPlayedBang; }
    public boolean isSkipTurn() { return skipTurn; }

    void drawCard(Card c) { if (c != null) hand.add(c); System.out.println(" > " + name + "이(가) [" + c.name + "] 카드를 획득했습니다."); }

    boolean respondToBang(Game game) {
        // 술통 판정
        for (Card c : field) {
            if (c instanceof BarrelCard) {
                Card check = game.drawCheck();
                if (check.suit == Suit.HEART) {
                    System.out.println(name + "의 술통 적중! 공격을 피했습니다.");
                    return true;
                }
            }
        }
        // 빗나감 카드 확인
        for (int i = 0; i < hand.size(); i++) {
            if (hand.get(i) instanceof MissedCard) {
                System.out.println(name + "가 [빗나감!] 사용.");
                game.deck.discard(hand.remove(i));
                return true;
            }
        }
        return false;
    }

    boolean discardSpecificCard(Class<? extends Card> clazz, Game game) {
        for (int i = 0; i < hand.size(); i++) {
            if (clazz.isInstance(hand.get(i))) {
                game.deck.discard(hand.remove(i));
                return true;
            }
        }
        return false;
    }
}

// ==========================================
// [5] 게임 엔진
// ==========================================
class Game {
    List<Player> players;
    Deck deck = new Deck();
    Scanner sc = new Scanner(System.in);
    int currentPlayerIdx = 0;

    public Game(List<Player> players) { this.players = players; deck.initDeck(); }

    public void start() {
        initializing();
        while (!isGameOver()) {
            Player p = players.get(currentPlayerIdx);
            if (p.hp > 0) runTurn(p);
            currentPlayerIdx = (currentPlayerIdx + 1) % players.size();
        }
    }

    void initializing() {
        List<Role> roles = new ArrayList<>(Arrays.asList(Role.SHERIFF, Role.OUTLAW, Role.OUTLAW, Role.RENEGADE));
        Collections.shuffle(roles);
        for (int i = 0; i < players.size(); i++) {
            Player p = players.get(i);
            p.role = roles.get(i);
            p.character = (i % 2 == 0) ? new BartCassidy() : new WillyTheKid();
            p.maxHp = p.character.hp + (p.role == Role.SHERIFF ? 1 : 0);
            p.hp = p.maxHp;
            for (int j = 0; j < p.hp; j++) p.drawCard(deck.popCard());
        }
        System.out.println("\n=== BANG! 시작 ===");
    }

    void runTurn(Player p) {
        System.out.println("\n-------------------------------------------");
        System.out.println("[" + p.name + "의 차례 시작]");
        System.out.println("현재 상태 - HP: " + p.hp + "/" + p.maxHp + " | 역할: " + p.role);
        p.hasPlayedBang = false;

        // Phase 0: 판정
        if (!handleFieldEffects(p)) return;

        // Phase 1: 드로우
        System.out.println("\n[Phase 1: 카드 드로우]");
        System.out.print("드로우 전 핸드 (" + p.hand.size() + "장): ");
        showHand(p);

        p.character.onPhase1(p, this);

        System.out.print("드로우 후 핸드 (" + p.hand.size() + "장): ");
        showHand(p);
        System.out.println("-------------------------------------------");

        // Phase 2: 카드 사용
        while (p.hp > 0) {
            showHand(p);
            System.out.print("사용할 번호 (-1 종료): ");
            int idx = sc.nextInt();
            if (idx == -1) break;
            if (idx >= 0 && idx < p.hand.size()) {
                Card card = p.hand.get(idx);
                if (card instanceof BangCard && p.hasPlayedBang && !p.character.canInfiniteBang()) {
                    System.out.println("뱅은 한 번만!"); continue;
                }
                Player target = null;
                if (card instanceof BangCard || card instanceof PanicCard || card instanceof CatBalouCard || card instanceof DuelCard || card instanceof JailCard) {
                    target = selectTarget(p, card);
                    if (target == null) continue;
                }
                p.hand.remove(idx);
                card.execute(p, target, this);
                if (card.type == CardType.BROWN) deck.discard(card);
            }
        }

        // Phase 3: 버리기
        while (p.hand.size() > p.hp) deck.discard(p.hand.remove(0));
    }

    boolean handleFieldEffects(Player p) {
        Iterator<Card> it = p.field.iterator();
        while (it.hasNext()) {
            Card c = it.next();
            if (c instanceof JailCard) {
                Card check = drawCheck();
                it.remove(); deck.discard(c);
                if (check.suit != Suit.HEART) {
                    System.out.println("탈옥 실패! 턴을 넘깁니다.");
                    return false;
                }
                System.out.println("탈옥 성공!");
            } else if (c instanceof DynamiteCard) {
                Card check = drawCheck();
                if (check.suit == Suit.SPADE && check.value >= 2 && check.value <= 9) {
                    System.out.println("펑! 다이너마이트 폭발!");
                    loseHP(p, null, 3);
                    it.remove(); deck.discard(c);
                } else {
                    System.out.println("다이너마이트가 다음 사람에게 전달됩니다.");
                    it.remove();
                    int nextIdx = (players.indexOf(p) + 1) % players.size();
                    players.get(nextIdx).field.add(c);
                }
            }
        }
        return true;
    }

    Card drawCheck() {
        Card c = deck.popCard();
        System.out.println("[판정] " + c.name + " (" + c.suit + " " + c.value + ")");
        deck.discard(c); return c;
    }

    Player selectTarget(Player a, Card c) {
        List<Player> targets = new ArrayList<>();
        for (Player p : players) {
            if (p != a && p.hp > 0) {
                if (c instanceof BangCard && !canHit(a, p)) continue;
                if (c instanceof PanicCard && getDist(a, p) > 1) continue;
                targets.add(p);
                System.out.println(targets.size()-1 + ". " + p.name);
            }
        }
        if (targets.isEmpty()) return null;
        int tIdx = sc.nextInt();
        return (tIdx >= 0 && tIdx < targets.size()) ? targets.get(tIdx) : null;
    }

    int getDist(Player a, Player t) {
        List<Player> alive = new ArrayList<>();
        for (Player p : players) if (p.hp > 0) alive.add(p);
        int ai = alive.indexOf(a), ti = alive.indexOf(t), n = alive.size();
        int base = Math.min(Math.abs(ai - ti), n - Math.abs(ai - ti));
        return base + t.character.getDistanceMod() + (t.hasMustang?1:0) - a.character.getRangeMod() - (a.hasAppaloosa?1:0);
    }

    boolean canHit(Player a, Player t) { return getDist(a, t) <= (a.weapon == null ? 1 : a.weapon.range); }
    void getHP(Player p, int amt) { p.hp = Math.min(p.hp + amt, p.maxHp); }
    void loseHP(Player t, Player a, int amt) {
        t.hp -= amt; System.out.println(t.name + " 피해! 현재 HP:" + t.hp);
        t.character.onDamaged(t, a, this, amt);
    }

    boolean isGameOver() {
        int outlaws = 0; boolean sheriff = false;
        for (Player p : players) {
            if (p.hp > 0) {
                if (p.role == Role.SHERIFF) sheriff = true;
                else outlaws++;
            }
        }
        if (!sheriff) { System.out.println("악당 승리!"); return true; }
        if (outlaws == 0) { System.out.println("정의 구현!"); return true; }
        return false;
    }

    void showHand(Player p) {
        for (int i = 0; i < p.hand.size(); i++) System.out.print("["+i+":"+p.hand.get(i).name+"] ");
        System.out.println();
    }
}

class Deck {
    List<Card> draw = new ArrayList<>(), discard = new ArrayList<>();
    Card popCard() {
        if (draw.isEmpty()) { draw.addAll(discard); discard.clear(); Collections.shuffle(draw); }
        return draw.remove(draw.size()-1);
    }
    void discard(Card c) { discard.add(c); }
    void initDeck() {
        for(int i=0; i<30; i++) draw.add(new BangCard());
        for(int i=0; i<15; i++) draw.add(new MissedCard());
        for(int i=0; i<8; i++) draw.add(new BeerCard());
        for(int i=0; i<3; i++) draw.add(new IndiansCard());
        for(int i=0; i<2; i++) draw.add(new GatlingCard());
        for(int i=0; i<3; i++) draw.add(new DuelCard());
        draw.add(new DynamiteCard());
        draw.add(new JailCard());
        draw.add(new BarrelCard());
        draw.add(new WeaponCard("Remington", 3));
        Collections.shuffle(draw);
    }
}

public class GameLogic {
    public static void main(String[] args) {
        new Game(Arrays.asList(new Player("P1"), new Player("P2"), new Player("P3"), new Player("P4"))).start();
    }
}